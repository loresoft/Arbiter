<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Description>Azure Monitor query handlers for Arbiter OpenTelemetry logs</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.Query" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arbiter.OpenTelemetry\Arbiter.OpenTelemetry.csproj" />
  </ItemGroup>

</Project>
